config_version=5

[application]
config/name="Purr & Tangle"
config/icon="res://assets/renders/cat_orange.png"
boot_splash/image="res://assets/ui/boot_splash.png"
boot_splash/bg_color=Color(0.956863, 0.937255, 0.87451, 1)
boot_splash/show_image=true
boot_splash/fullsize=true
boot_splash/use_filter=true
boot_splash/minimum_display_time=0
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]
window/size/viewport_width=1100
window/size/viewport_height=900
window/size/window_width_override=990
window/size/window_height_override=810
window/size/mode=2
window/stretch/mode="canvas_items"
window/size/resizable=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.075, 0.11, 0.12, 1)
textures/default_filters/use_nearest_mipmap_filter=false
